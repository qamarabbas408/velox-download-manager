{
  "manifest_version": 3,
  "name": "Velox Browser Integration",
  "description": "Send downloads to Velox, the fast segmented download manager.",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Velox",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["contextMenus", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"]
}
